<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <DefineConstants>$(DefineConstants);RDM_$(Platform)</DefineConstants>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RDM.Shared\RDM.Shared.csproj" />
    <ProjectReference Include="..\..\src\RDM.Data\RDM.Data.csproj" />
    <ProjectReference Include="..\..\src\RDM.Controller\RDM.Controller.csproj" />
    <!-- RDM.Client và RDM.Data cùng có lớp ClientService, nên dùng alias để không trùng tên. -->
    <ProjectReference Include="..\..\src\RDM.Client\RDM.Client.csproj" Aliases="rdmclient" />
    <ProjectReference Include="..\..\src\RDM.UI\RDM.UI.csproj" />
    <ProjectReference Include="..\..\src\RDM.App\RDM.App.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
