{
  "Urls": "http://127.0.0.1:7080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Relay": {
    "BindAddress": "0.0.0.0",
    "Port": 7443,
    "CertificatePath": "",
    "ControllerTokenSha256": "",
    "EnrollmentTokenSha256": "",
    "MaxConnections": 10000,
    "HeartbeatIntervalSeconds": 15,
    "HeartbeatTimeoutSeconds": 45,
    "HandshakeTimeoutSeconds": 10,
    "MaxAuthFailures": 20,
    "AuthBlockMinutes": 15,
    "MaxRelaySessions": 1000,
    "TicketSeconds": 30,
    "RelayIdleSeconds": 120,
    "SessionRequestsPerMinute": 30
  }
}
